+    def _conf_trim_num_draft(self) -> int | None:
+        """drafter-1a stage 0: the draft count for the next verify, or None to leave it.
+        Host-side, once per step; reads the realised walk scores of the block that was
+        just proposed (static buffer the replayed draft graph writes)."""
+        emitted = getattr(self, "last_num_emitted", None)
+        if emitted is None:
+            return None
+        num_reqs = emitted.shape[0]
+        # Throughput, for the cost-aware threshold: tokens emitted per wall-clock ms of
+        # step, both read without a sync. The step period is the host time between two
+        # calls (the scheduler is synchronous here); the emitted count arrives through a
+        # pinned copy one call later and is paired with the period it belongs to. Gaps
+        # between requests (> 1 s) are not steps.
+        now = time.perf_counter()
+        if self._trim_emit_n and self._trim_dt_prev is not None:
+            tok = float(self._trim_emit_cpu[: self._trim_emit_n].sum())
+            ms = self._trim_dt_prev * 1000.0
+            if 0.0 < ms < 1000.0 and tok > 0:
+                a = 0.1 if self._trim_ema_n >= 8 else 1.0 / (self._trim_ema_n + 1)
+                self._trim_ema_tok += a * (tok - self._trim_ema_tok)
+                self._trim_ema_ms += a * (ms - self._trim_ema_ms)
+                self._trim_ema_n += 1
+        self._trim_dt_prev = None if self._trim_t_prev is None else now - self._trim_t_prev
+        self._trim_t_prev = now
+        self._trim_emit_cpu[:num_reqs].copy_(emitted.to(torch.int32), non_blocking=True)
+        self._trim_emit_n = num_reqs
+
+        # Short context: an extra verify position is nearly free and a noisy predictor
+        # measured -8% at <=25k (drafter.md c3-c5), so leave the block alone.
+        if self.draft_max_seq_len < self._trim_min_ctx:
+            self._trim_surv_ready = False
+            return None
+        if self._trim_thr_fixed > 0:
+            thr = self._trim_thr_fixed
+        else:
+            if self._trim_ema_n < 4 or self._trim_ema_ms <= 0:
+                return None
+            thr = self._trim_ms_per_tok * self._trim_ema_tok / self._trim_ema_ms
+
+        block = self.draft_block
+        scores = self.candidate_sampler.scores[:num_reqs, :block]
+        conf = torch.softmax(scores, dim=-1).amax(dim=-1)
+        conf = torch.nan_to_num(conf, nan=1.0)
+        if self._lookup:
+            conf = torch.where(self._lookup_use[:num_reqs, :block] > 0, 1.0, conf)
+        # Survival is non-increasing in k, so per request the kept prefix is the count of
+        # positions at or above thr; one length serves the batch, the longest anyone wants.
+        surv = conf.cumprod(dim=1).amax(dim=0)
