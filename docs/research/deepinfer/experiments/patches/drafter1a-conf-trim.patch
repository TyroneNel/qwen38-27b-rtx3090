     def next_num_draft_tokens(self) -> int | None:
+        """The lookup's decision (below), then drafter-1a's confidence trim when it is on
+        and that decision is the drafter's own block."""
+        num_draft = self._next_num_draft_tokens_lookup()
+        if self._conf_trim and not (self._chain and self._chain_active):
+            base = self.num_speculative_steps if num_draft is None else num_draft
+            if base == self.draft_block:
+                trimmed = self._conf_trim_num_draft()
+                if trimmed is not None:
