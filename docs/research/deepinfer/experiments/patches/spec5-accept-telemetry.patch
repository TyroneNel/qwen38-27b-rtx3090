+class _Spec5Telemetry:
+    """spec-5 acceptance telemetry, on when SPEC5_TELEMETRY_DIR names a directory.
+
+    Adds the four per-position rows of _spec5_accept_stats_kernel (overlap
+    sum_x min(p, q), survival, drafts, realised accepts) into a float64 device
+    tensor and publishes it as <dir>/spec5-<pid>.json, cumulative since boot.
+    The device-to-host copy is non-blocking into pinned memory and the next
+    verify step publishes it once its event has completed, so no step waits on
+    the GPU and the file lags the device by one verify step.
+    """
+
+    def __init__(
+        self, out_dir: str, num_speculative_steps: int, device: torch.device
+    ):
+        self.acc = torch.zeros(
+            4, num_speculative_steps, dtype=torch.float64, device=device
+        )
+        self.is_cuda = self.acc.is_cuda
+        try:
+            self.host = torch.zeros(
+                self.acc.shape, dtype=self.acc.dtype, pin_memory=self.is_cuda
+            )
+        except RuntimeError:
+            # No pinned memory: the copy below is then synchronous.
+            self.host = torch.zeros(self.acc.shape, dtype=self.acc.dtype)
+        self.event = torch.cuda.Event() if self.is_cuda else None
+        self.pending = False
+        self.calls = 0
+        self.copied_calls = 0
+        self.started = time.time()
+        os.makedirs(out_dir, exist_ok=True)
+        self.path = os.path.join(out_dir, f"spec5-{os.getpid()}.json")
+
+    def step(self) -> None:
+        self.calls += 1
+        if self.pending:
+            assert self.event is not None
+            if not self.event.query():
+                return
+            self._publish()
+        self.host.copy_(self.acc, non_blocking=self.is_cuda)
+        self.copied_calls = self.calls
+        if self.event is not None:
+            self.event.record()
+            self.pending = True
+        else:
+            self._publish()
+
+    def _publish(self) -> None:
+        overlap, survival, drafts, accepted = self.host.tolist()
+        body = {
+            "pid": os.getpid(),
+            "started": self.started,
+            "updated": time.time(),
+            "calls": self.copied_calls,
+            "k": len(drafts),
+            "overlap": overlap,
+            "survival": survival,
+            "drafts": drafts,
+            "accepted": accepted,
+        }
+        tmp = self.path + ".tmp"
+        with open(tmp, "w") as f:
+            json.dump(body, f)
+        os.replace(tmp, self.path)
+        self.pending = False
+
+
