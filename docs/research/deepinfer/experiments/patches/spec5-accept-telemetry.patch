+@triton.jit
+def _spec5_accept_stats_kernel(
+    # [num_reqs, 4, num_speculative_steps], zero-initialised
+    stats_ptr,
+    # [num_reqs] accepted draft count, as _rejection_kernel stored it
+    num_accepted_ptr,
+    # [num_logits, V]
+    target_logits_ptr,
+    target_logits_stride,
+    # [num_logits, num_blocks]
+    target_local_argmax_ptr,
+    target_local_argmax_stride,
+    # [num_logits, num_blocks]
+    target_local_max_ptr,
+    target_local_max_stride,
+    # [num_logits, num_blocks]
+    target_local_sumexp_ptr,
+    target_local_sumexp_stride,
+    # [num_logits]
+    draft_sampled_ptr,
+    # [max_num_reqs, num_speculative_steps, V]
+    draft_logits_ptr,
+    draft_logits_stride_0,
+    draft_logits_stride_1,
+    # [num_logits, num_blocks]
+    draft_local_max_ptr,
+    draft_local_max_stride,
+    # [num_logits, num_blocks]
+    draft_local_sumexp_ptr,
+    draft_local_sumexp_stride,
+    # [num_reqs + 1]
+    cu_num_logits_ptr,
+    # [num_reqs]
+    idx_mapping_ptr,
+    # [max_num_reqs]
+    temp_ptr,
+    vocab_size,
+    vocab_num_blocks,
+    num_speculative_steps,
+    BLOCK_SIZE: tl.constexpr,
+    PADDED_VOCAB_NUM_BLOCKS: tl.constexpr,
+    HAS_DRAFT_LOGITS: tl.constexpr,
+):
+    # spec-5 telemetry. Per request and draft position i, four rows:
+    #   0: overlap   sum_x min(p_i(x), q_i(x)), the probability that position i
+    #                accepts a fresh draft given the drafted prefix
+    #   1: survival  prod_{j<=i} min(1, p_j(d_j) / q_j(d_j)), the probability
+    #                that the coins accept d_1..d_i; its sum over positions is
+    #                E[accepted | drafts], an unbiased, lower-variance stand-in
+    #                for the realised count
+    #   2: drafts    1 for every position the step verified
+    #   3: accepted  the realised accept, 1 if i < the accepted length
+    # Greedy requests use p = one-hot(target argmax), so rows 1 and 3 agree
+    # exactly; that identity is the patch's self-check.
+    req_idx = tl.program_id(0)
+    req_state_idx = tl.load(idx_mapping_ptr + req_idx).to(tl.int64)
+    start_idx = tl.load(cu_num_logits_ptr + req_idx).to(tl.int64)
+    end_idx = tl.load(cu_num_logits_ptr + req_idx + 1)
+    num_draft_tokens = end_idx - start_idx - 1
+    num_accepted = tl.load(num_accepted_ptr + req_idx)
+    temp = tl.load(temp_ptr + req_state_idx).to(tl.float32)
+    is_greedy = temp == 0.0
+    row_ptr = stats_ptr + req_idx * 4 * num_speculative_steps
+    survival = 1.0
+    for i in range(num_draft_tokens):
+        logit_idx = start_idx + i
+        draft_token = tl.load(draft_sampled_ptr + logit_idx + 1).to(tl.int64)
+        is_valid_draft = draft_token >= 0
+        draft_token = tl.maximum(0, draft_token)
+        accept_prob = 0.0
+        overlap = 0.0
+        if is_greedy:
+            target_argmax = _compute_global_target_argmax(
+                target_local_max_ptr,
+                target_local_max_stride,
+                target_local_argmax_ptr,
+                target_local_argmax_stride,
+                logit_idx,
+                vocab_num_blocks,
+                PADDED_VOCAB_NUM_BLOCKS,
+            )
+            accept_prob = tl.where(target_argmax == draft_token, 1.0, 0.0)
+            overlap = accept_prob
+        else:
+            target_logprob, draft_logprob, target_lse, draft_lse = (
+                _compute_global_logprobs_and_logsumexp(
+                    draft_token,
+                    True,  # mask
+                    logit_idx,
+                    req_state_idx,
+                    i,
+                    temp,
+                    target_logits_ptr,
+                    target_logits_stride,
+                    target_local_max_ptr,
+                    target_local_max_stride,
+                    target_local_sumexp_ptr,
+                    target_local_sumexp_stride,
+                    draft_logits_ptr,
+                    draft_logits_stride_0,
+                    draft_logits_stride_1,
+                    draft_local_max_ptr,
+                    draft_local_max_stride,
+                    draft_local_sumexp_ptr,
+                    draft_local_sumexp_stride,
+                    vocab_num_blocks,
+                    PADDED_VOCAB_NUM_BLOCKS,
+                    HAS_DRAFT_LOGITS,
+                )
+            )
+            accept_prob = tl.minimum(tl.exp(target_logprob - draft_logprob), 1.0)
+            if HAS_DRAFT_LOGITS:
+                for block_idx in range(vocab_num_blocks):
+                    offsets = block_idx * BLOCK_SIZE + tl.arange(0, BLOCK_SIZE)
+                    mask = offsets < vocab_size
+                    target_logits = tl.load(
+                        target_logits_ptr + logit_idx * target_logits_stride + offsets,
+                        mask=mask,
+                        other=float("-inf"),
+                    ).to(tl.float32)
+                    # draft_logits is stored pre-temperature, as in the stats kernel.
+                    draft_logits = (
+                        tl.load(
+                            draft_logits_ptr
+                            + req_state_idx * draft_logits_stride_0
+                            + i * draft_logits_stride_1
+                            + offsets,
+                            mask=mask,
+                            other=float("-inf"),
+                        ).to(tl.float32)
+                        / temp
+                    )
+                    overlap += tl.sum(
+                        tl.minimum(
+                            tl.exp(target_logits - target_lse),
+                            tl.exp(draft_logits - draft_lse),
+                        )
+                    )
+            else:
+                # One-hot draft: sum_x min(p(x), q(x)) = p(d).
+                overlap = tl.exp(target_logprob)
+        accept_prob = tl.where(is_valid_draft, accept_prob, 0.0)
+        overlap = tl.where(is_valid_draft, overlap, 0.0)
+        survival = survival * accept_prob
+        tl.store(row_ptr + i, overlap)
+        tl.store(row_ptr + num_speculative_steps + i, survival)
+        tl.store(row_ptr + 2 * num_speculative_steps + i, 1.0)
+        tl.store(
+            row_ptr + 3 * num_speculative_steps + i,
+            tl.where(i < num_accepted, 1.0, 0.0),
+        )
+
+
