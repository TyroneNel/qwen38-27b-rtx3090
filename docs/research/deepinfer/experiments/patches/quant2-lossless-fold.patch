+def lossless_fold_remap(
+    q: torch.Tensor, s: torch.Tensor, group_size: int
+) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+    """(quant-2) Lossless alternative to the negative-scale sign fold.
+
+    q: uint4b8 codes packed 8 per int32 along K, [K/8, N]; s: group scales
+    [K/G, N], some negative. Returns (q', |s|, zp) for the uint4 zero-point
+    kernel, zp unpacked int32 [K/G, N]: positive groups keep their codes with
+    zp 8, negative groups get code' = 15 - code with zp 7, so
+    (code' - zp) * |s| == (code - 8) * s for every code, -8 included.
+    """
+    neg = s < 0
+    neg_rows = neg.repeat_interleave(group_size // 8, dim=0)[: q.shape[0]]
+    shifts = torch.arange(0, 32, 4, device=q.device, dtype=torch.int32)
+    nib = (q.unsqueeze(-1) >> shifts) & 0xF
+    nib = torch.where(neg_rows.unsqueeze(-1), 15 - nib, nib)
+    out = torch.zeros_like(q)
+    for i in range(8):
+        out |= nib[..., i] << (4 * i)
+    del nib
+    zp = 8 - neg.to(torch.int32)
+    return out, s.abs(), zp
+
+
+_LOSSLESS_FOLD_LOGGED = False
+
+
 from .MPLinearKernel import MPLinearKernel, MPLinearLayerConfig
 
 
