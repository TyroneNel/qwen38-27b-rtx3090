+# runtime-3 experiment (docs/research/deepinfer/runtime.md), off unless VLLM_TOOL_CALL_BOUND=1.
+# A forced call (tool_choice required or named) under xgrammar's builtin templates can decode
+# whitespace until max_tokens: the qwen_xml argument grammar allows any run of whitespace
+# (root ::= [ \n\r\t]* for a tool with no parameters), and tool_choice=required lets any text
+# follow the call until EOS. With the knob on, for forced calls only:
+#   - every whitespace run inside the arguments is capped at VLLM_TOOL_CALL_MAX_WS characters
+#     (default 16; xgrammar's max_whitespace_cnt). String values are not touched;
+#   - required's free text between and after calls becomes calls joined by "\n", then at most
+#     VLLM_TOOL_CALL_MAX_WS whitespace characters, after which the grammar admits only EOS.
+# tool_choice=auto is never changed.
+_TOOL_CALL_BOUND = os.environ.get("VLLM_TOOL_CALL_BOUND", "0") == "1"
+_TOOL_CALL_MAX_WS = (
+    int(os.environ.get("VLLM_TOOL_CALL_MAX_WS", "16")) if _TOOL_CALL_BOUND else None
+)
+if _TOOL_CALL_MAX_WS is not None and _TOOL_CALL_MAX_WS < 1:
+    raise ValueError(f"VLLM_TOOL_CALL_MAX_WS must be >= 1, got {_TOOL_CALL_MAX_WS}")
+
+
+def _forced_tool_call_max_ws(
+    tools: list[dict[str, Any]], tool_choice: dict[str, Any] | str | None
+) -> int | None:
+    if _TOOL_CALL_MAX_WS is None:
+        return None
+    if normalize_tool_choice(tools, tool_choice)[2] == "auto":
+        return None
+    return _TOOL_CALL_MAX_WS
+
+
+def _bound_tool_call_tail(fmt: Any, max_ws: int) -> Any:
+    if isinstance(fmt, TriggeredTagsFormat) and fmt.at_least_one:
+        return SequenceFormat(
+            elements=[
+                TagsWithSeparatorFormat(
+                    tags=fmt.tags,
+                    separator="\n",
+                    at_least_one=True,
+                    stop_after_first=fmt.stop_after_first,
+                ),
+                RegexFormat(pattern=f"[ \\t\\r\\n]{{0,{max_ws}}}"),
+            ]
+        )
+    if isinstance(fmt, SequenceFormat):
+        return SequenceFormat(
+            elements=[_bound_tool_call_tail(e, max_ws) for e in fmt.elements]
+        )
+    return fmt
+
+
