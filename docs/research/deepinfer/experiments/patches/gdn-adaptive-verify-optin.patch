+    @classmethod
+    def get_varlen_cudagraph_max_query_len(
+        cls,
+        vllm_config: "VllmConfig",
+        kv_cache_spec: "KVCacheSpec",
+    ) -> int | None:
+        # HyperQwen experiment (VLLM_FA2_VARLEN_VERIFY=1, off by default): claim that
+        # an FA2 FULL graph captured at the verify width k+1 replays any 1..k+1 mix.
+        # The varlen kernel and the split-KV verify read per-request q_len from the
+        # device cu_seqlens; the host max_query_len stays an upper bound. Unproven on
+        # FA2 (and on the fa2_fp8kv plugin, which inherits this): validate greedy
+        # bit-identity before trusting it.
+        if cls._cudagraph_support == AttentionCGSupport.ALWAYS:
+            return None
+        if not envs.VLLM_FA2_VARLEN_VERIFY:
+            return None
+        spec = vllm_config.speculative_config
+        if spec is None or not spec.num_speculative_tokens:
+            return None
+        return spec.num_speculative_tokens + 1
