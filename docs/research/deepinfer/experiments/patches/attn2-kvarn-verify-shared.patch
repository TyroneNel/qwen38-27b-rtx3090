+# ──────────────────────────────────────────────────────────────────────────────
+# attn-2 experiment (KVARN_VERIFY_SHARED=1): the shared-dequant verify, revised.
+#
+# The per-token verify path (VQ_INDIRECT through _kvarn_fused_decode_stage1)
+# runs one program per (query TOKEN, kv head, split): at QLEN=8 every int4 K/V
+# tile is loaded and dequantized 8 times, and every tl.dot has M = Q_PER_KV_PAD
+# = 8 real-or-padded rows, which the MMA pads to 16 -- on the tf32 m16n8k8 MMA
+# when F16 is off. Both costs scale with QLEN x context, which is what the
+# E profile measured (7.3 ms/layer at 170k, ~40x its DRAM floor).
+#
+# Here one program per (REQUEST, kv head, split) dequantizes each chunk once
+# and feeds it to all QLEN * Q_PER_KV query rows, packed densely
+# (row r = token r // Q_PER_KV, head lane r % Q_PER_KV; 8 x 6 = 48 rows padded
+# to M_PAD = 64, not 8 x 8). The dots take fp16 operands (fp16 m16n8k16, fp32
+# accumulate; the dequant math itself stays fp32 unless KVARN_FP16_DEQUANT),
+# and PV16 optionally accumulates each chunk's P@V in fp16. Differences from
+# _kvarn_fused_verify_stage1 (KVARN_SHARED_VERIFY):
+#   - dense row packing: any QLEN works (no power-of-2 guard), fewer pad rows;
+#   - no early return: a padded request (seq_len <= 0) writes empty partials
+#     (O = 0, lse = -inf), so stage 2 never reads uninitialized scratch;
+#   - fixed launch config (KVARN_VERIFY_SHARED_CFG), no warmup-shape autotune;
+#   - the split count is a runtime argument; stage 2 masks to it.
+# ──────────────────────────────────────────────────────────────────────────────
+
+
+# The split count (and the scratch row stride that equals it) is runtime and
+# unspecialized, so the boot warmup and every serving batch share one variant.
+@triton.jit(do_not_specialize=["n_splits", "stride_ml_n"])
+def _kvarn_verify_shared_stage1(
+    Q_ptr,              # [NQ = B*QLEN, Hq, D] fp16 (rotated, token-major)
+    Block_table_ptr,    # [B, max_blocks] int32 (row b = request b)
+    Seq_lens_ptr,       # [NQ] int32 vq plan; request b's length = entry b*QLEN+QLEN-1
+    Block_to_slot_ptr, KV_cache_ptr,
+    Tail_K_pool_ptr, Tail_V_pool_ptr,
+    MidO_ptr,           # [NQ*Hq, n_splits, D] fp32
+    MidLse_ptr,         # [NQ*Hq, n_splits]    fp32
+    scale,
+    stride_q_t, stride_q_h,
+    stride_bt_b,
+    stride_kv_b, stride_kv_h,
+    stride_pool_b, stride_pool_t, stride_pool_h,
+    stride_mo_n, stride_mo_s, stride_ml_n,
+    n_splits,
+    D: tl.constexpr, GROUP: tl.constexpr, BLOCK_N: tl.constexpr,
+    QLEN: tl.constexpr, Q_PER_KV: tl.constexpr, M_PAD: tl.constexpr,
+    HQ: tl.constexpr, SLIDING_WINDOW: tl.constexpr,
+    K_BITS: tl.constexpr, V_BITS: tl.constexpr,
+    NUM_BLOCKS_LOOKUP: tl.constexpr,
+    K_PACKED_OFFSET: tl.constexpr, K_S_COL_OFFSET: tl.constexpr,
+    K_ZP_OFFSET: tl.constexpr, K_S_ROW_OFFSET: tl.constexpr,
+    V_PACKED_OFFSET: tl.constexpr, V_S_COL_OFFSET: tl.constexpr,
+    V_S_ROW_OFFSET: tl.constexpr, V_ZP_OFFSET: tl.constexpr,
+    F16: tl.constexpr = False,
+    PV16: tl.constexpr = False,
+):
+    b = tl.program_id(0)
+    hk = tl.program_id(1)
+    split = tl.program_id(2)
+
+    r = tl.arange(0, M_PAD)
+    j = r // Q_PER_KV                                      # token index in request
+    lane = r % Q_PER_KV                                    # query head in the GQA group
+    rmask = r < QLEN * Q_PER_KV
+    hq0 = hk * Q_PER_KV
+    tok_row = b * QLEN + j
+    d_offs = tl.arange(0, D)
+
+    # Padded requests (uniform-batch capture/replay) carry seq_len <= 0: they
+    # get an empty block range and still write their (empty) partials below.
+    seq_len = tl.maximum(tl.load(Seq_lens_ptr + b * QLEN + (QLEN - 1)), 0)
+    limit = seq_len - QLEN + j + 1                         # [M_PAD] causal kv limit
+
+    PACK_K: tl.constexpr = 8 // K_BITS
+    PACK_V: tl.constexpr = 8 // V_BITS
+    MASK_K: tl.constexpr = (1 << K_BITS) - 1
+    MASK_V: tl.constexpr = (1 << V_BITS) - 1
+    d_byte_v = d_offs // PACK_V
+    d_shift_v = (d_offs % PACK_V) * V_BITS
+
+    q = tl.load(Q_ptr + tok_row[:, None] * stride_q_t
+                + (hq0 + lane)[:, None] * stride_q_h + d_offs[None, :],
+                mask=rmask[:, None], other=0.0).to(tl.float16)  # [M_PAD, D]
+    qk_scale = scale * 1.4426950408889634                 # exp2 domain
+
+    m_i = tl.full([M_PAD], -float("inf"), dtype=tl.float32)
+    l_i = tl.zeros([M_PAD], dtype=tl.float32)
+    acc = tl.zeros([M_PAD, D], dtype=tl.float32)
+
+    n_blocks = (seq_len + GROUP - 1) // GROUP
+    blocks_per_split = (n_blocks + n_splits - 1) // n_splits
+    blk_lo = split * blocks_per_split
+    blk_hi = tl.minimum(blk_lo + blocks_per_split, n_blocks)
+
+    for k in range(blk_lo, blk_hi):
+        n_tok = tl.minimum(seq_len - k * GROUP, GROUP)
+        block_id = tl.load(Block_table_ptr + b * stride_bt_b + k)
+        in_range = (block_id >= 0) & (block_id < NUM_BLOCKS_LOOKUP)
+        safe_bid = tl.where(in_range, block_id, 0)
+        pool_slot = tl.load(Block_to_slot_ptr + safe_bid, mask=in_range, other=-1)
+        tile_base = block_id.to(tl.int64) * stride_kv_b + hk * stride_kv_h
+        safe_slot = tl.where(pool_slot >= 0, pool_slot, 0)
+        pool_base = safe_slot.to(tl.int64) * stride_pool_b + hk * stride_pool_h
+
+        ku16 = (KV_cache_ptr + tile_base).to(tl.pointer_type(tl.uint16))
+        s_col_K = tl.load(ku16 + (K_S_COL_OFFSET // 2) + d_offs).to(tl.float16, bitcast=True)
+        s_col_K = s_col_K.to(tl.float32) if not F16 else s_col_K
+        zp_K = tl.load(ku16 + (K_ZP_OFFSET // 2) + d_offs).to(tl.float16, bitcast=True)
+        zp_K = zp_K.to(tl.float32) if not F16 else zp_K
+        s_col_V = tl.load(ku16 + (V_S_COL_OFFSET // 2) + d_offs).to(tl.float16, bitcast=True)
+        s_col_V = s_col_V.to(tl.float32) if not F16 else s_col_V
+
+        for c0 in range(0, GROUP, BLOCK_N):
+            cols = c0 + tl.arange(0, BLOCK_N)
+            cmask = cols < n_tok
+            kvpos = k * GROUP + cols
+            if pool_slot >= 0:
+                src = pool_base + cols[:, None] * stride_pool_t + d_offs[None, :]
+                Kc = tl.load(Tail_K_pool_ptr + src, mask=cmask[:, None], other=0.0)
+                Vc = tl.load(Tail_V_pool_ptr + src, mask=cmask[:, None], other=0.0)
+                K_dg = tl.trans(Kc.to(tl.float16))                       # [D, BN]
+                Vc = Vc.to(tl.float16)                                   # [BN, D]
+            else:
+                cb_k = cols // PACK_K
+                cs_k = (cols % PACK_K) * K_BITS
+                s_row_K = tl.load(ku16 + (K_S_ROW_OFFSET // 2) + cols).to(tl.float16, bitcast=True)
+                s_row_K = s_row_K.to(tl.float32) if not F16 else s_row_K
+                k_bytes = tl.load(KV_cache_ptr + tile_base + K_PACKED_OFFSET
+                                  + d_offs[:, None] * (GROUP // PACK_K) + cb_k[None, :]).to(tl.int32)
+                q_K = (k_bytes >> cs_k[None, :]) & MASK_K
+                q_K = q_K.to(tl.float16) if F16 else q_K.to(tl.float32)
+                K_dg = ((q_K * s_col_K[:, None] + zp_K[:, None])
+                        * s_row_K[None, :]).to(tl.float16)               # [D, BN]
+                s_row_V = tl.load(ku16 + (V_S_ROW_OFFSET // 2) + cols).to(tl.float16, bitcast=True)
+                s_row_V = s_row_V.to(tl.float32) if not F16 else s_row_V
+                zp_V = tl.load(ku16 + (V_ZP_OFFSET // 2) + cols).to(tl.float16, bitcast=True)
+                zp_V = zp_V.to(tl.float32) if not F16 else zp_V
+                v_bytes = tl.load(KV_cache_ptr + tile_base + V_PACKED_OFFSET
+                                  + cols[:, None] * (D // PACK_V) + d_byte_v[None, :]).to(tl.int32)
+                q_V = (v_bytes >> d_shift_v[None, :]) & MASK_V
+                q_V = q_V.to(tl.float16) if F16 else q_V.to(tl.float32)
+                Vc = ((q_V * s_row_V[:, None] + zp_V[:, None])
+                      * s_col_V[None, :]).to(tl.float16)                 # [BN, D]
+
+            scores = tl.dot(q, K_dg) * qk_scale                          # [M_PAD, BN]
+            smask = cmask[None, :] & (kvpos[None, :] < limit[:, None])
+            if SLIDING_WINDOW > 0:
+                smask = smask & (kvpos[None, :]
+                                 >= tl.maximum(limit[:, None] - SLIDING_WINDOW, 0))
+            scores = tl.where(smask, scores, -float("inf"))
+            m_new = tl.maximum(m_i, tl.max(scores, axis=1))
+            # A row with no live key yet keeps m = -inf; subtracting a finite
+            # stand-in keeps p and alpha at exactly 0 instead of NaN.
+            m_use = tl.where(m_new == -float("inf"), 0.0, m_new)
+            p = tl.exp2(scores - m_use[:, None]).to(tl.float16)
+            alpha = tl.exp2(m_i - m_use)
+            l_i = l_i * alpha + tl.sum(p.to(tl.float32), axis=1)
+            if PV16:
+                pv = tl.dot(p, Vc, out_dtype=tl.float16).to(tl.float32)
+            else:
+                pv = tl.dot(p, Vc)
+            acc = acc * alpha[:, None] + pv
+            m_i = m_new
+
+    nonempty = l_i > 0
+    l_safe = tl.where(nonempty, l_i, 1.0)
+    O_s = acc / l_safe[:, None]
+    lse_s = tl.where(nonempty, (m_i + tl.log2(l_safe)) * 0.6931471805599453,
+                     -float("inf"))                                     # natural log
+    rows = tok_row * HQ + hq0 + lane
+    tl.store(MidO_ptr + rows[:, None] * stride_mo_n + split * stride_mo_s
+             + d_offs[None, :], O_s, mask=rmask[:, None])
+    tl.store(MidLse_ptr + rows * stride_ml_n + split, lse_s, mask=rmask)
+
+
+@triton.jit(do_not_specialize=["n_splits", "stride_ml_n"])
+def _kvarn_verify_shared_stage2(
+    MidO_ptr, MidLse_ptr, Out_ptr,
+    stride_mo_n, stride_mo_s, stride_ml_n, stride_o_n,
+    n_splits,
+    D: tl.constexpr, S_PAD: tl.constexpr, S_CHUNK: tl.constexpr,
+):
+    # One program per output row; LSE-combine n_splits partials, S_CHUNK at a
+    # time (an [S_PAD, D] fp32 tile would not fit in registers at 64+ splits).
+    n = tl.program_id(0)
+    d_offs = tl.arange(0, D)
+    s_all = tl.arange(0, S_PAD)
+    lse_all = tl.load(MidLse_ptr + n * stride_ml_n + s_all,
+                      mask=s_all < n_splits, other=-float("inf"))
+    g = tl.max(lse_all, axis=0)
+    g_safe = tl.where(g == -float("inf"), 0.0, g)
+    denom = tl.sum(tl.exp(lse_all - g_safe), axis=0)
+    acc = tl.zeros([D], dtype=tl.float32)
+    for s0 in range(0, n_splits, S_CHUNK):
+        s = s0 + tl.arange(0, S_CHUNK)
+        smask = s < n_splits
+        w = tl.exp(tl.load(MidLse_ptr + n * stride_ml_n + s, mask=smask,
+                           other=-float("inf")) - g_safe)
+        o = tl.load(MidO_ptr + n * stride_mo_n + s[:, None] * stride_mo_s + d_offs[None, :],
+                    mask=smask[:, None], other=0.0)
+        acc += tl.sum(w[:, None] * o, axis=0)
+    out = acc / tl.where(denom > 0, denom, 1.0)
+    tl.store(Out_ptr + n * stride_o_n + d_offs, out.to(tl.float16))
+
+
+_SM_COUNT: dict[int, int] = {}
+
+
+def verify_shared_m_pad(qlen: int, q_per_kv: int) -> int:
+    """Q-tile rows of _kvarn_verify_shared_stage1: QLEN*Q_PER_KV, next pow2, >= 16."""
+    m = max(qlen * q_per_kv, 1)
+    return max(16, 1 << (m - 1).bit_length())
+
+
+def verify_shared_splits(B: int, Hk: int, max_ctx_blocks: int,
+                         device: torch.device) -> int:
+    """KV splits: KVARN_VERIFY_SHARED_SPLITS, else ~2 programs per SM. Depends
+    only on the batch shape and the deployment's block bound (graph-safe)."""
+    if _VERIFY_SHARED_SPLITS:
+        s = int(_VERIFY_SHARED_SPLITS)
+    else:
+        idx = device.index if device.index is not None else torch.cuda.current_device()
+        if idx not in _SM_COUNT:
+            _SM_COUNT[idx] = torch.cuda.get_device_properties(idx).multi_processor_count
+        s = -(-2 * _SM_COUNT[idx] // max(B * Hk, 1))
+    return max(1, min(s, max(max_ctx_blocks, 1), 256))
+
+
+def verify_shared_config(m_pad: int) -> tuple[int, int, int]:
+    """(BLOCK_N, num_warps, num_stages): KVARN_VERIFY_SHARED_CFG, else the
+    default. ptxas -v (sm_86, D=256, Q_PER_KV=6): at M_PAD 32 and 64 only the
+    8-warp configs are spill-free with F16 off (BLOCK_N 16/32: 186-250
+    registers, 0 spills; every 2- and 4-warp config spills 500-12000 B), and
+    num_stages does not change the code (the loads feed the dequant, not the
+    dot, so nothing is pipelined). M_PAD 128 (QLEN >= 11 at G=6) spills at
+    every config tried (BLOCK_N 16/32 x 4/8 warps; least at 16,8: ~300-500 B);
+    it is correct but not tuned."""
+    if _VERIFY_SHARED_CFG:
+        bn, nw, ns = (int(x) for x in _VERIFY_SHARED_CFG.split(","))
+        return bn, nw, ns
+    return (32, 8, 1) if m_pad <= 64 else (16, 8, 1)
+
+
+def kvarn_verify_shared_launch(
+    q_rot: torch.Tensor,                # [NQ, Hq, D] fp16, rotated
+    out_rot: torch.Tensor,              # [NQ, Hq, D] fp16, written (rotated frame)
+    kv_cache: torch.Tensor,             # [num_blocks, Hk, TILE_BYTES] uint8
+    block_table: torch.Tensor,          # [>= B, max_blocks] int32
+    vq_seqlen: torch.Tensor,            # [NQ] int32 per-token causal lengths
+    scale: float,
+    cfg,
+    impl,
+    qlen: int,
+    max_ctx_blocks: int,
+    n_splits: int | None = None,
+    config: tuple[int, int, int] | None = None,
+    pv16: bool | None = None,
+    f16: bool | None = None,
+) -> torch.Tensor:
+    """Launch the KVARN_VERIFY_SHARED stage 1 + stage 2 (the overrides are for
+    the microbench / tests; serving uses the env-derived defaults)."""
+    NQ, Hq, D = q_rot.shape
+    Hk = kv_cache.shape[1]
+    B = NQ // qlen
+    qpk = Hq // Hk
+    m_pad = verify_shared_m_pad(qlen, qpk)
+    S = n_splits or verify_shared_splits(B, Hk, max_ctx_blocks, q_rot.device)
+    bn, nw, ns = config or verify_shared_config(m_pad)
+    Nrows = NQ * Hq
+    mid_o = torch.empty(Nrows, S, D, dtype=torch.float32, device=q_rot.device)
+    mid_lse = torch.empty(Nrows, S, dtype=torch.float32, device=q_rot.device)
+    pool_k, pool_v = impl._tail_K_pool, impl._tail_V_pool
+    _kvarn_verify_shared_stage1[(B, Hk, S)](
+        q_rot, block_table, vq_seqlen, impl._block_to_slot_t,
+        kv_cache, pool_k, pool_v, mid_o, mid_lse, scale,
+        q_rot.stride(0), q_rot.stride(1), block_table.stride(0),
+        kv_cache.stride(0), kv_cache.stride(1),
+        pool_k.stride(0), pool_k.stride(1), pool_k.stride(2),
+        mid_o.stride(0), mid_o.stride(1), mid_lse.stride(0),
+        S,
+        D=D, GROUP=cfg.group, BLOCK_N=bn, QLEN=qlen, Q_PER_KV=qpk, M_PAD=m_pad,
+        HQ=Hq, SLIDING_WINDOW=int(getattr(impl, "sliding_window", 0) or 0),
+        K_BITS=cfg.key_bits, V_BITS=cfg.value_bits,
+        NUM_BLOCKS_LOOKUP=impl._block_lookup_size,
