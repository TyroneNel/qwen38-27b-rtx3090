# Every env file holds local settings and usually VLLM_API_KEY (.env, .env.hf,
# .env.bench, .env.long, .env.host, backups such as .env.keep-*). Only the
# template is tracked.
.env*
!.env.example
# NOTE: docker-compose.override.yml is TRACKED (portable, no host specifics).
# Host-local overrides belong in docker-compose.override.local.yml (also ignored).
docker-compose.override.local.yml
.quant_checkpoint/
prepare/logs/
# Local/working docs stay uncommitted: only the docs tracked in upstream/main
# are versioned. New local docs (investigation notes, handoffs, plans) are
# ignored by default; anything meant for the repo must be added to the
# allowlist below AND committed deliberately.
docs/*
!docs/MR-DRAFT.md
!docs/docker.md
!docs/gotchas.md
!docs/long-context.md
!docs/media/
!docs/optimizations.md
!docs/python-314.md
!docs/quality.md
!docs/reproductions/
!docs/spec-decode-scratch-token-units.md
!docs/ubuntu-3090.md
!docs/wsl2-4090.md
# Eval run outputs (timestamped results/samples) — regenerate, don't version.
evals/
# Scratch handoff docs — working notes, not repo history.
handoff-*.md
