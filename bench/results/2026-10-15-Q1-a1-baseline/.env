# batch 5 base: int8 CTX=fast at the full pin (5583457484); band 2 is this with DFLASH_TOKENS=3. Arms change one line each.
MODELS_DIR=G:/models
VLLM_WSL2_ENABLE_PIN_MEMORY=1
CUDA_VISIBLE_DEVICES=GPU-2e8e4d29-ecb0-5fbf-7a84-d2370311be84
NVIDIA_VISIBLE_DEVICES=GPU-2e8e4d29-ecb0-5fbf-7a84-d2370311be84
PREPARE=0
VERIFY=0
PORT=18020
SPEC=dflash2
PREFIX_CACHE=1
CTX=fast
DFLASH_TOKENS=3
KV_MEM=5583457484
MAX_LEN=65536
# the cap lifted on every seat question (brief: "MAX_SEQS hides the seat effect")
MAX_SEQS=16
EXTRA_ARGS='--attention-backend TRITON_ATTN --kv-cache-dtype int8_per_token_head'
# batch 3: the engine's stats line every 2 s instead of 10, so a 512-token wave yields several Running: samples; identical on every arm
VLLM_LOG_STATS_INTERVAL=2
